# Copy to apps/api/.env and preserve your existing MySQL credentials and APP_KEY.
NODE_ENV=production
APP_URL=https://your-domain.example
API_HOST=127.0.0.1
API_PORT=4000
APP_KEY=base64:YOUR_EXISTING_LARAVEL_KEY
NODE_SESSION_SECRET=CHANGE_TO_A_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SESSION_SECURE_COOKIE=true
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=existing_waflow_database
DB_USERNAME=existing_database_user
DB_PASSWORD=
DB_SSL=false
NODE_WORKER_ENABLED=true
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_BUSINESS_PLAN_ID=
# Real SMTP is required; Laravel's log mailer does not deliver email.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
