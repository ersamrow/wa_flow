# Hostinger backend app: api.waflow.myledgerpro.in
# Import into the backend app's Environment Variables settings after filling placeholders.
# Do not commit a filled-in copy or replace your local development .env.
NODE_ENV=production
# Browser origin: use the FRONTEND domain for CSRF and password-reset links.
APP_URL=https://waflow.myledgerpro.in
API_HOST=0.0.0.0
API_PORT=3000

# Preserve the exact existing APP_KEY, including its base64: prefix if present.
# Never generate a replacement key for an existing database.
APP_KEY=REPLACE_WITH_EXACT_EXISTING_APP_KEY
# Generate separately: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
NODE_SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET
SESSION_SECURE_COOKIE=true
# Trusts loopback proxy peers only. Verify HTTPS forwarding in Hostinger.
TRUST_PROXY=true

DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_HOSTINGER_DATABASE_HOST
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_DATABASE_NAME
DB_USERNAME=REPLACE_WITH_DATABASE_USERNAME
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# Set true if required by your database server.
DB_SSL=false
DB_POOL_MAX=10

# Change to true after migration, verification, and stopping old Laravel workers.
NODE_WORKER_ENABLED=false

# Fill in for WhatsApp; use a Graph API version supported by your Meta app.
WHATSAPP_GRAPH_VERSION=REPLACE_WITH_SUPPORTED_GRAPH_VERSION
WHATSAPP_APP_ID=REPLACE_WITH_META_APP_ID
WHATSAPP_APP_SECRET=REPLACE_WITH_META_APP_SECRET
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_WEBHOOK_VERIFY_TOKEN
# Enable only after configuring Embedded Signup in Meta.
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=REPLACE_WITH_EMBEDDED_SIGNUP_CONFIG_ID

# Fill in for AI replies.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# Fill in for Razorpay billing.
RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET
RAZORPAY_STARTER_PLAN_ID=REPLACE_WITH_STARTER_PLAN_ID
RAZORPAY_BUSINESS_PLAN_ID=REPLACE_WITH_BUSINESS_PLAN_ID

# Required for password-reset emails. Use your SMTP provider's actual settings.
# For implicit TLS on port 465, use MAIL_PORT=465 and MAIL_ENCRYPTION=ssl.
MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=REPLACE_WITH_SENDER_EMAIL
